DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
JWT_SECRET=replace-with-a-long-random-secret

# Selects the AI backend behind chatbot intent-detection, Q&A, and plan
# adaptation (see src/ai/index.ts). Only "rule-based" exists today; add a
# new provider file implementing AiProvider and a case here to switch.
AI_PROVIDER=rule-based
