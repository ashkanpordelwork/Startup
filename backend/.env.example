DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
JWT_SECRET=replace-with-a-long-random-secret

# Selects the AI backend behind chatbot intent-detection, Q&A, and plan
# adaptation (see src/ai/index.ts). "rule-based" (default) uses no external
# API. "avalai" uses DeepSeek via AvalAI's OpenAI-compatible endpoint.
AI_PROVIDER=rule-based

# Required when AI_PROVIDER=avalai. Get one at https://avalai.ir (Developer
# dashboard -> API Keys). Keep this secret — never commit the real value.
AVALAI_API_KEY=
# Optional: override the default model (deepseek-chat)
AVALAI_MODEL=deepseek-chat
